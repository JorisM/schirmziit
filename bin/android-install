#!/usr/bin/env bash
# Build, install on the phone, and launch it.
#
# No cable needed: the phone is reached over wifi whenever it is paired for
# wireless debugging — see android_wifi_connect in _lib.sh. A USB device, if one
# is plugged in, wins simply by already being there.
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
need_dev_shell "$@"

serial="${ANDROID_SERIAL:-$(one_android_device)}"
export ANDROID_SERIAL="$serial"
say "device $serial ($(adb -s "$serial" shell getprop ro.product.model | tr -d '\r'))"

"$root/bin/android-build" "${1:-debug}"

say "installing"
cd "$root/android" && ./gradlew "installDebug"

# Launching matters: the agent asks for the usage-access grant on first open, and
# an installed-but-never-opened app records nothing at all.
package=ch.jorisda.schirmziit.agent
say "launching $package"
adb -s "$serial" shell am start -n "$package/.ui.MainActivity" >/dev/null
bold "→ installed and launched on $serial"
