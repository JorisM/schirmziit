{
  "openapi": "3.1.0",
  "info": {
    "title": "Schirmziit API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session cookie issued"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Too many attempts from this IP"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session deleted"
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Family and first parent created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredResponse"
                }
              }
            }
          },
          "403": {
            "description": "Registration disabled"
          },
          "409": {
            "description": "Email already registered"
          },
          "422": {
            "description": "Password too short"
          }
        }
      }
    },
    "/v1/children": {
      "get": {
        "tags": [
          "children"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Children in this family",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChildResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Unknown timezone"
          }
        }
      },
      "post": {
        "tags": [
          "children"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewChild"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Child created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Empty display name"
          }
        }
      }
    },
    "/v1/children/{id}": {
      "delete": {
        "tags": [
          "children"
        ],
        "summary": "Hides the child and stops their phones, in one transaction.",
        "description": "The row itself survives — historical usage stays attributable, and the\ndedicated `DELETE /v1/children/{id}/data` is what actually erases figures,\ndeliberately separate so \"delete my child's data\" is its own reported act.\n\nRevoking the devices is not tidying-up: `Device` authorizes on\n`devices.revoked_at` alone, so without this a phone whose child is gone from\nevery parent screen keeps uploading hours that nothing can read back. A\nparent removing a child means \"and stop reporting\".",
        "operationId": "soft_delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Hidden, and its devices revoked"
          },
          "404": {
            "description": "No such child in this family"
          }
        }
      }
    },
    "/v1/children/{id}/data": {
      "delete": {
        "tags": [
          "children"
        ],
        "operationId": "purge",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rows actually deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurgeResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such child in this family"
          }
        }
      }
    },
    "/v1/children/{id}/devices": {
      "post": {
        "tags": [
          "devices"
        ],
        "summary": "Enrol the phone the parent is holding, without a pairing code.",
        "description": "This is what makes one app work for both roles: a parent signs in on the\nchild's phone, picks the child, and the app trades that session for a device\ntoken — then deletes the session, so no parent credentials and no parent\nsession stay behind on a child's phone. Codes remain for the case where the\nparent is not there to sign in.",
        "operationId": "claim_device",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimDevice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Device enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimedDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "No such child in this family"
          },
          "422": {
            "description": "Empty platform, model or label"
          }
        }
      }
    },
    "/v1/children/{id}/enrollments": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "mint_enrollment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "One-time enrollment code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such child in this family"
          }
        }
      }
    },
    "/v1/children/{id}/insight": {
      "get": {
        "tags": [
          "usage"
        ],
        "operationId": "insight",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "The local date the parent is looking at. Today is part of neither week\n— the comparison ends yesterday — but it decides where the two weeks\nfall, and only the client knows which day it is where the family lives.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The last full week against the one before it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsightResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such child in this family"
          },
          "422": {
            "description": "Unknown timezone"
          }
        }
      }
    },
    "/v1/children/{id}/usage": {
      "get": {
        "tags": [
          "usage"
        ],
        "operationId": "usage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Child id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage series for the requested local dates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such child in this family"
          },
          "422": {
            "description": "Unknown timezone"
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "tags": [
          "devices"
        ],
        "operationId": "list_devices",
        "responses": {
          "200": {
            "description": "Devices in this family",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/v1/devices/{id}": {
      "delete": {
        "tags": [
          "devices"
        ],
        "operationId": "revoke_device",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Token revoked"
          },
          "404": {
            "description": "No such device in this family"
          }
        }
      }
    },
    "/v1/enroll": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "enroll",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Device enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolledResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown, expired or already-used code"
          }
        }
      }
    },
    "/v1/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "ingest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per-row accept/reject result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported schema version"
          },
          "401": {
            "description": "Unknown or revoked device token"
          },
          "413": {
            "description": "Too many hours in one batch"
          },
          "429": {
            "description": "Device rate limit"
          }
        },
        "security": [
          {
            "device_token": []
          }
        ]
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in parent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/v1/me/usage": {
      "get": {
        "tags": [
          "usage"
        ],
        "summary": "The one read a device token buys, and it takes no id: a device sees the child\nit was enrolled for and has no way to name another. `/v1/children` and every\nother parent route still refuse a device token — there is a test for it.",
        "operationId": "my_usage",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "This device's own child, for the requested local dates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown or revoked device token"
          },
          "422": {
            "description": "Unknown timezone"
          },
          "429": {
            "description": "Device read limit"
          }
        },
        "security": [
          {
            "device_token": []
          }
        ]
      }
    },
    "/v1/waitlist": {
      "post": {
        "tags": [
          "waitlist"
        ],
        "operationId": "join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "On the list — also the answer when the address was already on it"
          },
          "422": {
            "description": "Not an email address, or a language the site does not speak"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppMove": {
        "type": "object",
        "description": "One app, in both weeks. `ms` may be lower than `previous_ms`; a mover moves\nin either direction and the renderer says which.",
        "required": [
          "package",
          "label",
          "foreground_ms",
          "previous_foreground_ms"
        ],
        "properties": {
          "foreground_ms": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "previous_foreground_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ChildResponse": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "today_ms"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "today_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Foreground milliseconds so far in the caller's local today. Zero, never\nnull: a quiet day is a real number and an absent one renders as a hole."
          }
        }
      },
      "ClaimDevice": {
        "type": "object",
        "required": [
          "platform",
          "model",
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        }
      },
      "ClaimedDeviceResponse": {
        "type": "object",
        "required": [
          "device_id",
          "token"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "description": "Long-lived, write-only. Shown once; only its hash is stored."
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "DeviceResponse": {
        "type": "object",
        "required": [
          "id",
          "child_id",
          "platform",
          "model",
          "label",
          "revoked",
          "stale"
        ],
        "properties": {
          "child_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "model": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "required": [
          "id",
          "label",
          "stale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "DeviceTotal": {
        "type": "object",
        "required": [
          "start",
          "screen_on_ms",
          "unlock_count",
          "background_measured"
        ],
        "properties": {
          "background_measured": {
            "type": "boolean",
            "description": "False means none of the devices reporting this bucket could observe\nbackground playback — not that nothing played. Rendering the two alike\nis the silent zero this product exists not to tell."
          },
          "screen_on_ms": {
            "type": "integer",
            "format": "int64"
          },
          "start": {
            "type": "string",
            "description": "RFC3339 instant for hourly buckets, `YYYY-MM-DD` for daily ones — same\ndual format as `Point.start`, and the exact field a wrong `bucket` on\nthe client side answers wrong for (`crates/core/src/selfusage.rs`)."
          },
          "unlock_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EnrollRequest": {
        "type": "object",
        "required": [
          "code",
          "platform",
          "model",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        }
      },
      "EnrolledResponse": {
        "type": "object",
        "required": [
          "device_id",
          "token"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "description": "Long-lived, write-only. Shown once; only its hash is stored."
          }
        }
      },
      "EnrollmentResponse": {
        "type": "object",
        "required": [
          "code",
          "expires_at",
          "qr_payload"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "qr": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QrCode",
                "description": "`qr_payload` drawn, so no client needs an encoder and all three draw\nthe same square. Null only when the payload does not fit in any QR\nversion — see `schirmziit_core::qr::encode`. A client that gets null\nkeeps showing the code and the URL as text, which is what it showed\nbefore this field existed: a square that cannot be drawn costs a scan,\nnever the pairing."
              }
            ]
          },
          "qr_payload": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "SZ-E101",
          "SZ-E102",
          "SZ-E103",
          "SZ-E104",
          "SZ-E105",
          "SZ-E106",
          "SZ-E201",
          "SZ-E202",
          "SZ-E203",
          "SZ-E204",
          "SZ-E205",
          "SZ-E301",
          "SZ-E302",
          "SZ-E303",
          "SZ-E304",
          "SZ-E501",
          "SZ-E502",
          "SZ-E503",
          "SZ-E504",
          "SZ-E505",
          "SZ-E506",
          "SZ-E601",
          "SZ-E602",
          "SZ-E603",
          "SZ-E604",
          "SZ-E605",
          "SZ-E701",
          "SZ-E702",
          "SZ-E703",
          "SZ-E704",
          "SZ-E705",
          "SZ-E706",
          "SZ-E707",
          "SZ-E901",
          "SZ-E902"
        ]
      },
      "IngestApp": {
        "type": "object",
        "required": [
          "package",
          "label",
          "foreground_ms",
          "launch_count"
        ],
        "properties": {
          "background_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Media playing with the screen off. Separate from `foreground_ms` in\nevery consumer; never add the two together."
          },
          "foreground_ms": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": "string"
          },
          "launch_count": {
            "type": "integer",
            "format": "int32"
          },
          "package": {
            "type": "string"
          }
        }
      },
      "IngestHour": {
        "type": "object",
        "required": [
          "hour_start",
          "tz",
          "computed_at",
          "screen_on_ms",
          "unlock_count",
          "apps"
        ],
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngestApp"
            }
          },
          "background_measured": {
            "type": "boolean",
            "description": "Whether this device could observe background playback at all for this\nhour. `false` is NOT \"nothing played\" — it is \"we do not know\": an\niPhone, or an Android phone whose family declined the grant."
          },
          "computed_at": {
            "type": "string",
            "format": "date-time"
          },
          "hour_start": {
            "type": "string",
            "format": "date-time"
          },
          "screen_on_ms": {
            "type": "integer",
            "format": "int64"
          },
          "tz": {
            "type": "string"
          },
          "unlock_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IngestRequest": {
        "type": "object",
        "required": [
          "schema",
          "device_time",
          "hours"
        ],
        "properties": {
          "device_time": {
            "type": "string",
            "format": "date-time"
          },
          "hours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngestHour"
            }
          },
          "schema": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "IngestResponse": {
        "type": "object",
        "required": [
          "accepted",
          "rejected"
        ],
        "properties": {
          "accepted": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rejected"
            }
          }
        }
      },
      "InsightResponse": {
        "type": "object",
        "required": [
          "child_id",
          "tz",
          "week"
        ],
        "properties": {
          "child_id": {
            "type": "string",
            "format": "uuid"
          },
          "tz": {
            "type": "string"
          },
          "week": {
            "$ref": "#/components/schemas/WeekComparison"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "family_id"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "family_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "NewChild": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          }
        }
      },
      "Point": {
        "type": "object",
        "required": [
          "start",
          "foreground_ms",
          "launch_count",
          "background_ms"
        ],
        "properties": {
          "background_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Media playing with the screen off. A separate measure: never add it to\n`foreground_ms`, on any surface."
          },
          "foreground_ms": {
            "type": "integer",
            "format": "int64"
          },
          "launch_count": {
            "type": "integer",
            "format": "int32"
          },
          "start": {
            "type": "string",
            "description": "RFC3339 instant for hourly buckets, `YYYY-MM-DD` for daily ones."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "The body of every error response.\n\n`detail` is for the log and the copy-details block a parent can send. It is\nnever rendered as the message a parent reads: it is English, and the app\nspeaks four languages. The client looks the copy up by `code`.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "ref"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "description": "Six hex characters, the head of the request id. Filled in by the\nnormalise layer, which is the only place with access to the request."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "PurgeResponse": {
        "type": "object",
        "description": "Deletes for real and reports what went, so \"delete my child's data\" is\nverifiable rather than a promise.",
        "required": [
          "deleted_usage_hours",
          "deleted_device_hours",
          "deleted_usage_days"
        ],
        "properties": {
          "deleted_device_hours": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "deleted_usage_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "deleted_usage_hours": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "QrCode": {
        "type": "object",
        "description": "A square of modules, row by row, `1` dark and `0` light — the quiet zone\nincluded, so `size` is what a renderer draws and nothing more is needed.\n\nCharacters rather than booleans: this crosses the API as JSON, where 33\nrows of `\"1011…\"` stay readable in a response a self-hoster is debugging,\nand an array of 1681 booleans does not.",
        "required": [
          "size",
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`size` strings of `size` characters each."
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Modules per side, quiet zone included.",
            "minimum": 0
          }
        }
      },
      "RegisteredResponse": {
        "type": "object",
        "required": [
          "family_id"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Rejected": {
        "type": "object",
        "required": [
          "hour_start",
          "reason",
          "permanent"
        ],
        "properties": {
          "hour_start": {
            "type": "string",
            "format": "date-time"
          },
          "permanent": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "Series": {
        "type": "object",
        "required": [
          "package",
          "label",
          "points"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "required": [
          "child_id",
          "from",
          "to",
          "bucket",
          "tz",
          "devices",
          "series",
          "device_totals"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "child_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_totals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceTotal"
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceStatus"
            }
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Series"
            }
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "tz": {
            "type": "string"
          }
        }
      },
      "WaitlistRequest": {
        "type": "object",
        "required": [
          "email",
          "locale"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "description": "One of `de`, `fr`, `it`, `en`."
          }
        }
      },
      "WeekComparison": {
        "type": "object",
        "description": "Seven days against the seven before them.",
        "required": [
          "from",
          "to",
          "previous_from",
          "previous_to",
          "total_ms",
          "previous_total_ms",
          "evening_ms",
          "previous_evening_ms",
          "evening_from_hour",
          "movers",
          "previous_measured"
        ],
        "properties": {
          "evening_from_hour": {
            "type": "integer",
            "format": "int32",
            "description": "Shipped rather than assumed, so a renderer can name the hour it is\ntalking about instead of hard-coding a 21 of its own.",
            "minimum": 0
          },
          "evening_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Screen time from `evening_from_hour` to local midnight, a subset of\n`total_ms` and never something to add to it."
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "First and last local day of the recent week, both inclusive."
          },
          "movers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppMove"
            },
            "description": "Ranked by distance moved, longest first, at most [`MAX_MOVERS`]."
          },
          "previous_evening_ms": {
            "type": "integer",
            "format": "int64"
          },
          "previous_from": {
            "type": "string",
            "format": "date",
            "description": "The week before, both inclusive."
          },
          "previous_measured": {
            "type": "boolean",
            "description": "False when no device reported anything in the earlier week. A week\nagainst nothing is not a doubling, it is a first week, and every\nsurface has to say so rather than print a percentage."
          },
          "previous_to": {
            "type": "string",
            "format": "date"
          },
          "previous_total_ms": {
            "type": "integer",
            "format": "int64"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "total_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
