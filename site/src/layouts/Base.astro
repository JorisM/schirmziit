---
import '../styles/site.css'
import AlphaBanner from '../components/AlphaBanner.astro'
import Waitlist from '../components/Waitlist.astro'
import { localeNames, locales, prefix, sites, type Locale, type PageKey } from '../content'

interface Props {
  locale: Locale
  page: PageKey
}

const { locale, page } = Astro.props
const t = sites[locale]
const base = prefix(locale)
// One page's search-result copy, written for a result list rather than lifted
// from the headline above it -- see `Meta` in content/strings.ts.
const { title, description } = t.meta[page]

const pages = [
  { key: 'home' as const, href: base || '/', label: t.nav.home },
  { key: 'selfHost' as const, href: `${base}/self-hosting`, label: t.nav.selfHost },
  { key: 'hosted' as const, href: `${base}/hosted`, label: t.nav.hosted },
  { key: 'privacy' as const, href: `${base}/privacy`, label: t.nav.privacy },
]

// The same page in the other languages, for the switcher and for hreflang.
const pathFor = (target: Locale) => {
  const p = prefix(target)
  if (page === 'home') return p || '/'
  const slug = page === 'selfHost' ? 'self-hosting' : page
  return `${p}/${slug}`
}

const analyticsHost = import.meta.env.PUBLIC_UMAMI_HOST
const analyticsId = import.meta.env.PUBLIC_UMAMI_ID
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(pathFor(locale), Astro.site)} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={sites[l].htmlLang} href={new URL(pathFor(l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en'), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Self-hosted, cookieless counting. Injected only when configured, so a
        fork of this site ships without any analytics at all. */}
    {analyticsHost && analyticsId && (
      <>
        <script defer src={`${analyticsHost}/script.js`} data-website-id={analyticsId}></script>
        {/* One helper for every custom event on the site, defined in <head> so
            it exists before any body script runs. The tracker itself is
            `defer`, so it is NOT loaded yet at that point — queue until load
            rather than dropping the event. `window.szTrack` staying undefined
            when analytics is unconfigured is the whole guard: every call site
            uses `?.`, so a fork emits nothing. */}
        <script is:inline>
          window.szTrack = (name, data) => {
            const send = () => window.umami && window.umami.track(name, data)
            if (window.umami) send()
            else window.addEventListener('load', send, { once: true })
          }
        </script>
      </>
    )}
  </head>
  <body>
    <AlphaBanner locale={locale} />
    <header class="site">
      <div class="wrap">
        <a class="brand" href={base || '/'}>
          <svg class="brand-mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
            <path d="M32,28 L32,47 Q32,52 26.5,52" fill="none" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" />
            <circle cx="20" cy="39.7" r="3.2" fill="var(--ink)" />
            <path d="M16.4,50.5 v-3.2 a3.6,3.6 0 0 1 7.2,0 v3.2 Z" fill="var(--ink)" />
            <circle cx="44" cy="39.7" r="3.2" fill="var(--ink)" />
            <path d="M40.4,50.5 v-3.2 a3.6,3.6 0 0 1 7.2,0 v3.2 Z" fill="var(--ink)" />
            <path d="M8,26 L17.6,14.35 L17.6,34 Q12.8,28.5 8,34 Z" fill="var(--ribbon-1)" />
            <path d="M17.6,14.35 L27.2,10.45 L27.2,34 Q22.4,28.5 17.6,34 Z" fill="var(--ribbon-3)" />
            <path d="M27.2,10.45 L36.8,10.45 L36.8,34 Q32,28.5 27.2,34 Z" fill="var(--accent)" />
            <path d="M36.8,10.45 L46.4,14.35 L46.4,34 Q41.6,28.5 36.8,34 Z" fill="var(--ribbon-3)" />
            <path d="M46.4,14.35 L56,26 L56,34 Q51.2,28.5 46.4,34 Z" fill="var(--ribbon-1)" />
          </svg>
          Schirmziit
        </a>
        <span class="swiss">🇨🇭 {t.swissLabel}</span>
        <nav class="site">
          {pages.map((p) => (
            <a href={p.href} aria-current={p.key === page ? 'page' : undefined}>{p.label}</a>
          ))}
          <span class="langs">
            {locales.map((l) => (
              <a href={pathFor(l)} aria-current={l === locale ? 'true' : undefined} lang={sites[l].htmlLang} data-locale={l}>
                {localeNames[l].slice(0, 2).toUpperCase()}
              </a>
            ))}
          </span>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
      <Waitlist locale={locale} />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>🇨🇭 {t.footer.madeIn}</span>
        <a href="https://github.com/JorisM/schirmziit">{t.footer.source}</a>
        <a href="mailto:joris@morger-gossweiler.ch">{t.footer.contact}</a>
      </div>
    </footer>

    {/* The custom events the saved Umami reports are built on. A page view
        already carries the URL, but a funnel needs a first step that is the
        same across four locale prefixes, and `site-view` is it — it also
        carries `page`/`locale` as event data, which a raw path does not.
        Clicks are delegated from one listener so no markup grows handlers. */}
    <script is:inline define:vars={{ page, locale }}>
      window.szTrack?.('site-view', { page, locale })

      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a')
        if (!link) return

        if (link.classList.contains('alpha-cta')) {
          window.szTrack?.('banner-cta', { page, locale })
        } else if (link.closest('.langs')) {
          // Only a real change is a switch; clicking the current language is not.
          const to = link.dataset.locale
          if (to && to !== locale) window.szTrack?.('lang-switch', { from: locale, to })
        } else if (link.closest('footer.site')) {
          if (link.protocol === 'mailto:') window.szTrack?.('contact-click', { page, locale })
          else window.szTrack?.('source-click', { page, locale })
        }
      })
    </script>
  </body>
</html>
