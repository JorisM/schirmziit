<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read other apps' foreground time. Special permission: it cannot be
         requested in-app, the user grants it in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Android 11+ package visibility hides other apps from PackageManager, so
         getApplicationLabel falls back to raw ids like com.audiobookshelf.app and
         the dashboard shows package names instead of "Audiobookshelf". A
         screen-time reporter has to resolve every app it measures. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android's Doze/App Standby can defer WorkManager indefinitely on a phone
         that sits idle, which shows up as a device going stale in the dashboard
         while the child is simply not using it. The exemption is requested
         through the system dialog (never granted silently) and only suggested
         when syncs are actually being missed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NestlingApp"
        android:label="Nestling"
        android:allowBackup="false"
        android:supportsRtl="true"
        tools:targetApi="37">
        <!-- Exported and in the launcher on purpose: the child must be able to
             open this app and see what is being recorded. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Nestling">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The dashboard's QR payload. With this, any camera or scanner app
                 opens us with the code already in hand, instead of the parent
                 having to launch the app and scan a second time. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nestling" android:host="enroll" />
                <data android:scheme="nestling" android:host="sync" />
            </intent-filter>
        </activity>
    </application>
</manifest>
