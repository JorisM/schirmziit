---
import Base from '../layouts/Base.astro'
import { sites, type Locale } from '../content'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = sites[locale]
---
<Base locale={locale} page="hosted" title={`${t.hosted.title} — Schirmziit`} description={t.hosted.lead}>
  <h1>{t.hosted.title}</h1>
  <p class="lead">{t.hosted.lead}</p>

  <h2>{t.hosted.whereTitle}</h2>
  <p>{t.hosted.whereBody}</p>

  <h2>{t.hosted.scaleTitle}</h2>
  <p>{t.hosted.scaleBody}</p>

  <h2>{t.hosted.priceTitle}</h2>
  <p>{t.hosted.priceBody}</p>

  <h2>{t.hosted.joinTitle}</h2>
  <p>{t.hosted.joinBody}</p>
  <div class="buttons">
    <a class="button" href="mailto:joris@morger-gossweiler.ch?subject=Schirmziit%20Alpha">{t.hosted.joinCta}</a>
  </div>
</Base>
