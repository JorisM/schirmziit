#!/usr/bin/env bash
# One-time setup: install nix, then build the dev shell.
#
# Everything else in bin/ re-enters that shell on its own, so this is the only
# script that has to work with nothing installed.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*" >&2; }
ok()   { printf '\033[1;32m  ✓ \033[0m%s\n' "$*"; }

if ! command -v nix >/dev/null 2>&1; then
  say "installing Determinate Nix"
  # Determinate's installer, not the upstream one: it enables flakes by default,
  # survives a macOS upgrade wiping /nix, and uninstalls cleanly.
  curl -fsSL https://install.determinate.systems/nix | sh -s -- install

  # The installer only patches the shell profiles, which this shell has already
  # read — so source the daemon profile to make nix usable in this run.
  # shellcheck disable=SC1091
  [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ] \
    && . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
else
  ok "nix already installed ($(nix --version))"
fi

command -v nix >/dev/null 2>&1 || {
  warn "nix is installed but not on this shell's PATH — open a new terminal and re-run bin/setup"
  exit 1
}

say "building the dev shell (first run downloads the Android SDK and NDK — several GB)"
nix develop "$root" --command true
ok "dev shell ready"

if command -v direnv >/dev/null 2>&1; then
  say "direnv found — run 'direnv allow' in $root to have the shell always on"
  say "  nushell needs its hook written by hand: docs/direnv-nushell.md"
fi

if [ "$(uname)" = "Darwin" ]; then
  if command -v xcodebuild >/dev/null 2>&1; then
    developer_dir="$(xcode-select -p 2>/dev/null || true)"
    case "$developer_dir" in
      *CommandLineTools*)
        warn "xcode-select points at the Command Line Tools, so iOS builds will fail."
        warn "Fix: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"
        ;;
      *) ok "Xcode at $developer_dir" ;;
    esac
  else
    # Not fatal: the Rust, web and Android sides all work without it.
    warn "no Xcode — install it from the App Store for the iOS scripts."
  fi

  if ! docker info >/dev/null 2>&1; then
    warn "docker is not running — bin/db and bin/dev need it for Postgres."
  else
    ok "docker is running"
  fi
fi

echo
bold "Ready. What you can run:"
cat <<'USAGE'
  bin/dev               api on 8099, dashboard on 5173, site on 4321
  bin/check             every gate (rust, web, android, ios, site)
  bin/doctor            what this machine has, and what it is missing

  bin/android-build     apk for the child agent
  bin/android-install    ... and install it on the connected phone
  bin/ios-build         Schirmziit.app for the simulator (--device to sign for a phone)
  bin/ios-install        ... and install it on a device or booted simulator

  bin/db up|psql|reset  the dev Postgres
  bin/record ios|android  re-record the screenshot goldens, deliberately

Every script enters the nix shell itself, so none of them need a special
terminal. `direnv allow` if you would rather have the shell always on.
USAGE
