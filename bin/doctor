#!/usr/bin/env bash
# What this machine has, and what it is missing.
#
# Written against the failures that actually cost time here: a Homebrew `cargo`
# ahead of the dev shell's on PATH (its error says "target may not be installed",
# which sends you to `rustup target add`, which says the target is already
# there), no ANDROID_NDK_HOME, no JAVA_HOME, adb not on PATH, and xcode-select
# pointing at the Command Line Tools.
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
need_dev_shell "$@"

problems=0

ok()   { printf '  \033[1;32m✓\033[0m %-22s %s\n' "$1" "${2:-}"; }
bad()  { printf '  \033[1;31m✗\033[0m %-22s %s\n' "$1" "${2:-}"; problems=$((problems + 1)); }
note() { printf '  \033[1;33m!\033[0m %-22s %s\n' "$1" "${2:-}"; }

have() {
  local label="$1" cmd="$2" version="${3:-}"
  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$label" "$( [ -n "$version" ] && eval "$version" 2>&1 | head -1 || command -v "$cmd" )"
  else
    bad "$label" "not found"
  fi
}

bold "Shell"
ok "dev shell" "active"
have nix nix 'nix --version'
# Optional, always: every script re-enters the shell on its own. It only says
# whether the always-on path is wired, and never turns it on for you — allowing
# an .envrc is the user's call, not a script's.
if ! command -v direnv >/dev/null 2>&1; then
  note direnv "not installed — optional, the scripts enter the shell themselves"
elif [ -n "${DIRENV_FILE:-}" ]; then
  ok direnv "$DIRENV_FILE"
else
  note direnv "installed, but this shell is not in it — direnv allow"
fi

bold "Rust"
have rustc rustc 'rustc --version'
cargo_path="$(command -v cargo || true)"
case "$cargo_path" in
  /nix/store/*) ok cargo "$cargo_path" ;;
  "")           bad cargo "not found" ;;
  *)            bad cargo "$cargo_path is not the dev shell's — a Homebrew or rustup cargo is winning on PATH" ;;
esac
for target in aarch64-apple-ios aarch64-apple-ios-sim aarch64-linux-android x86_64-linux-android; do
  # `rustc --print target-libdir` is the honest check: it answers from the
  # toolchain actually being used, not from rustup's idea of what is installed.
  if rustc --print target-libdir --target "$target" >/dev/null 2>&1; then
    ok "std $target"
  else
    bad "std $target" "missing — this toolchain cannot cross-compile to it"
  fi
done
have cargo-ndk cargo-ndk 'cargo ndk --version'
have sqlx sqlx 'sqlx --version'

bold "Android"
have java java 'java -version'
[ -n "${JAVA_HOME:-}" ] && ok JAVA_HOME "$JAVA_HOME" || bad JAVA_HOME "unset"
if [ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME" ]; then
  ok ANDROID_HOME "$ANDROID_HOME"
  platforms="$(ls "$ANDROID_HOME/platforms" 2>/dev/null | tr '\n' ' ')"
  [ -n "$platforms" ] && ok platforms "$platforms" || bad platforms "none installed"
else
  bad ANDROID_HOME "${ANDROID_HOME:-unset}"
fi
if [ -n "${ANDROID_NDK_HOME:-}" ] && [ -d "$ANDROID_NDK_HOME" ]; then
  ok ANDROID_NDK_HOME "$ANDROID_NDK_HOME"
else
  bad ANDROID_NDK_HOME "${ANDROID_NDK_HOME:-unset} — cargo-ndk has no linker without it"
fi
have adb adb 'adb version'
if command -v adb >/dev/null 2>&1; then
  # Reporting only — doctor never connects anything. But say what to do, since
  # "none connected" reads as "go find a cable" and wifi is the default here.
  devices="$(android_devices | tr '\n' ' ')"
  if [ -n "$devices" ]; then
    ok "devices" "$devices"
  else
    note "devices" "none — bin/android-install finds a wifi-paired phone by mdns"
  fi
fi

bold "iOS"
if [ "$(uname)" != "Darwin" ]; then
  note "xcode" "not macOS — the iOS scripts do not apply here"
elif command -v xcodebuild >/dev/null 2>&1; then
  # `DEVELOPER_DIR=` on purpose: nixpkgs' darwin stdenv exports it pointing at
  # its own apple-sdk, and xcode-select answers from the variable before the
  # xcode-select link — so without clearing it this reports a /nix/store path
  # and looks fine while iOS builds have no iPhoneOS platform.
  developer_dir="$(DEVELOPER_DIR= xcode-select -p 2>/dev/null || true)"
  case "$developer_dir" in
    *CommandLineTools*) bad "xcode-select" "$developer_dir — iOS builds need Xcode.app, not the CLT" ;;
    /Applications/*|/Library/Developer/*)
      ok "xcode" "$(DEVELOPER_DIR="$developer_dir" xcodebuild -version | head -1) at $developer_dir" ;;
    *) bad "xcode-select" "$developer_dir is not an Xcode — sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" ;;
  esac
else
  bad "xcode" "not installed — install it from the App Store"
fi
have xcodegen xcodegen 'xcodegen --version'

bold "Web and site"
have node node 'node --version'
have pnpm pnpm 'pnpm --version'
have just just 'just --version'

bold "Database"
engine="$(compose_engine)"
if ! command -v "$engine" >/dev/null 2>&1; then
  bad "$engine" "not found"
elif ! "$engine" info >/dev/null 2>&1; then
  bad "$engine" "installed but not running"
elif db_is_up; then
  ok "postgres" "up on 5433"
else
  note "postgres" "not running — bin/db up"
fi
have psql psql 'psql --version'

echo
if [ "$problems" = 0 ]; then
  bold "Nothing missing."
else
  bold "$problems problem(s) above."
  exit 1
fi
