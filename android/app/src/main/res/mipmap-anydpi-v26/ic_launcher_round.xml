<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so the adaptive icon is the only icon: no legacy PNG
     mipmaps to keep in sync. The monochrome layer is what Android 13+ themed
     icons tint; without it the launcher falls back to a washed-out crop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
