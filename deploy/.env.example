# Copy to .env next to docker-compose.yml and edit.

# Any long random string. Avoid / + = so it drops into the connection URL
# without escaping:  openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# The address you will actually open in a browser and that phones will reach.
# Include the scheme, no trailing slash. This is baked into pairing QR codes.
PUBLIC_URL=https://nestling.example.ch

# first-user-only (default) | off | open
ALLOW_REGISTRATION=first-user-only

# Hourly rows are folded into daily totals after this many months.
RETENTION_HOURLY_MONTHS=13
RETENTION_JOB_AT=04:00

TZ=Europe/Zurich
RUST_LOG=info
