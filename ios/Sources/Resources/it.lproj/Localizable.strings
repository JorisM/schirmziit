"help.never.title" = "Cosa Schirmziit non raccoglie mai";
"help.never.1" = "Né messaggi, né chat, né ricerche, né foto, né digitazioni.";
"help.never.2" = "Nessuna posizione.";
"help.never.3" = "Nessun sito web e nessun video guardato.";
"help.never.4" = "Nessuna registrazione del microfono o della fotocamera.";
"help.never.5" = "Non viene bloccato nulla — Schirmziit non spegne nessuna app.";
"help.how.title" = "Come funziona";
"help.how.1" = "Una piccola app sul telefono del bambino legge le statistiche d'uso che Android tiene comunque.";
"help.how.2" = "Circa ogni 30 minuti invia valori orari al tuo server.";
"help.how.3" = "Senza internet non si perde nulla: i valori restano sul telefono.";
"help.how.4" = "Questa app legge solo ciò che il tuo server ha già.";
"help.where.title" = "Dove stanno i dati";
"help.where" = "Sul server della tua famiglia, nel tuo database. Nessuna azienda in mezzo, nessuna trasmissione a terzi.";
